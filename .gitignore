# ==============================================================================
# Fintel Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
# Node & Frontend (Next.js)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TypeScript build info
*.tsbuildinfo
frontend/next-env.d.ts

# Vercel
.vercel/

# ------------------------------------------------------------------------------
# Databases & Persistence Volumes
# ------------------------------------------------------------------------------
.pgdata/
pgdata/
postgres_data/
grafana_data/
prometheus_data/
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# Large Datasets (> 100MB exceeds GitHub push limits)
# ------------------------------------------------------------------------------
data/raw/*.csv
data/raw/*.zip
data/raw/*.tar.gz
data/raw/*.gz
!data/raw/README.md
!data/raw/.gitkeep

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp/
temp/
.temp/

# ------------------------------------------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
