# Fintel — Environment Variables
# Copy this to .env and fill in your values:  cp .env.example .env

# PostgreSQL
POSTGRES_USER=Fintel
POSTGRES_PASSWORD=Fintel_dev_2026
POSTGRES_DB=Fintel

# Database URL (used by backend services and scripts)
DATABASE_URL=postgresql://Fintel:Fintel_dev_2026@localhost:5432/Fintel

# For services running inside Docker network, use the service name:
# DATABASE_URL=postgresql://Fintel:Fintel_dev_2026@db:5432/Fintel

# LLM API Key (Person 5 — pick Claude or OpenAI and standardize)
LLM_API_KEY=your-api-key-here

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus
PROMETHEUS_RETENTION=15d
